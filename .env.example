# Copy to `.env` and fill in. `.env` is git-ignored and is NOT bundled into the
# Angular app — only Edge Functions and local tooling read it.
#
# Browser-safe values (URL + publishable key) are duplicated in
# src/environments/*.ts, which is what the website actually uses.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret / service-role key. Bypasses RLS. Server-side only — never import this
# from anything under src/.
SUPABASE_SECRET_KEY=sb_secret_xxx

SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional: unsigned Cloudinary upload for ticket photos. Leave unset to use the
# Supabase Storage bucket `ticket-photos` instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UNSIGNED_PRESET=
